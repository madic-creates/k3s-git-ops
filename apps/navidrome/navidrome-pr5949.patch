@@ -553,3 +553,47 @@ func fetchAndParse(rssURL string) (*rssFeed, error) {
 
 	return ParseRSSFeed(data)
 }
+
+// validateURL checks that a user-supplied podcast URL is a well-formed http(s)
+// URL that does not point into the local network.
+//
+// RSS feed and episode enclosure URLs come from user input and are fetched
+// server-side, so an unvalidated URL is a server-side request forgery vector
+// (see the //nolint:gosec markers on the callers).
+//
+// The scheme and host checks mirror conf.validateURL; the address check mirrors
+// isPrivateOrLoopback in plugins/host_httpclient.go. Like that one, this is a
+// cheap guard against IP literals, not a defence against DNS rebinding: a
+// hostname that resolves to a private address is not caught.
+func validateURL(rawURL string) error {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return fmt.Errorf("parsing URL %q: %w", rawURL, err)
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return fmt.Errorf("invalid scheme %q: only 'http' and 'https' are allowed", u.Scheme)
+	}
+	if u.Host == "" || u.Opaque != "" {
+		return fmt.Errorf("invalid URL %q: a full http(s) URL with a non-empty host is required", rawURL)
+	}
+	// url.URL.Hostname already strips the port and IPv6 brackets, which is what
+	// extractHostname does for the plugin host client.
+	if isPrivateOrLoopback(u.Hostname()) {
+		return fmt.Errorf("URL %q is not allowed: private, loopback and link-local addresses are blocked", rawURL)
+	}
+	return nil
+}
+
+// isPrivateOrLoopback reports whether hostname is a private, loopback or
+// link-local IP address, or the name "localhost". Mirrors the helper of the
+// same name in plugins/host_httpclient.go.
+func isPrivateOrLoopback(hostname string) bool {
+	if strings.EqualFold(hostname, "localhost") {
+		return true
+	}
+	ip := net.ParseIP(hostname)
+	if ip == nil {
+		return false
+	}
+	return ip.IsLoopback() || ip.IsPrivate() || ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast()
+}
